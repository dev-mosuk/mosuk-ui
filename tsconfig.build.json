{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "tsc-alias": {
    "fileExtensions": {
      "outputCheck": ["js", "json", "jsx", "mjs", "cjs", "css", "d.ts"]
    }
  }
} 