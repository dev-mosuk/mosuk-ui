{
  "name": "mosuk-ui",
  "version": "1.0.20",
  "author": "mosuk",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --loader ts-node/esm helpers/build-dist.ts",
    "build:watch": "npm run build && tsc -w -p tsconfig.build.json & tsc-alias -w -p tsconfig.build.json & node --loader ts-node/esm helpers/watch-dist-assets.ts",
    "watch:assets": "node --loader ts-node/esm helpers/watch-dist-assets.ts",
    "link:dist": "npm run build && cd dist && npm link",
    "lint": "eslint src",
    "migrate:imports": "node helpers/migrate-to-alias-imports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@internationalized/date": "^3.12.4",
    "classnames": "^2.5.1",
    "lucide-react": "latest",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-file-icon": "^1.6.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-textarea-autosize": "^8.5.9",
    "swiper": "^11.2.10"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@yandex/ymaps3-types": "^1.0.17595433",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10",
    "tsc-alias": "^1.8.17",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
