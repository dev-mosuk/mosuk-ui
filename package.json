{
  "name": "mosuk-ui",
  "version": "1.0.17",
  "type": "module",
  "scripts": {
    "watch": "node --loader ts-node/esm --watch=src tsconfig.ts",
    "build": "tsc -p tsconfig.build.json && node --loader ts-node/esm helpers/copy-dist-css.ts && tsc-alias -p tsconfig.build.json && node --loader ts-node/esm tsconfig.build.ts",
    "build:watch": "npm run build && tsc -w -p tsconfig.build.json & tsc-alias -w -p tsconfig.build.json & node --loader ts-node/esm helpers/watch-dist-assets.ts",
    "watch:assets": "node --loader ts-node/esm helpers/watch-dist-assets.ts",
    "link:dist": "npm run build && cd dist && npm link",
    "lint": "eslint src",
    "migrate:imports": "node helpers/migrate-to-alias-imports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "lucide-react": "latest",
    "mosuk-icons": "^1.0.5",
    "mosuk-utilities": "^1.0.0",
    "react-hook-form": "^7.56.4",
    "react-imask": "^7.6.1",
    "react-textarea-autosize": "^8.5.9",
    "swiper": "^11.2.6",
    "swr": "^2.3.8",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "framer-motion": "^12.34.3",
    "next": "^15.3.4 || ^16.0.0-beta.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@yandex/ymaps3-types": "^1.0.17595433",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10",
    "tsc-alias": "^1.8.17",
    "typescript": "^5"
  }
}
