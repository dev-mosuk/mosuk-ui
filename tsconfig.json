{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "esnext"],
    "types": ["node", "react"],
    "typeRoots": ["node_modules/@types"],
    "jsx": "react",
    "module": "esnext",
    "declaration": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "helpers/**/*"],
  "exclude": ["node_modules", "dist"]
}
