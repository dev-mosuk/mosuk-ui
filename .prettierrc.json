{
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "jsxSingleQuote": true,
    "quoteProps": "as-needed",
    "plugins": [
        "prettier-plugin-organize-imports"
    ]
}